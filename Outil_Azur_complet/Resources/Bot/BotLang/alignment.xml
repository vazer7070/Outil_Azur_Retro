<entree table="A.b" id="0" d="Votre alignement est si faible que sa survie est menacée." e="10" n="Requiem" s="0" />
<entree table="A.b" id="1" d="Votre alignement survit difficilement dans un environnement très hostile." e="20" n="Survivant" s="10" />
<entree table="A.b" id="2" d="Votre alignement résiste envers et contre tout à l'envahisseur !" e="30" n="Guerilla" s="20" />
<entree table="A.b" id="3" d="Votre alignement est à genoux, mais il ne tardera pas à se relever." e="40" n="Minorité" s="30" />
<entree table="A.b" id="4" d="L'équilibre du Monde est au désavantage de votre alignement." e="50" n="Cohabitation" s="40" />
<entree table="A.b" id="5" d="Votre alignement domine de peu la Balance du Monde." e="60" n="Statu quo" s="50" />
<entree table="A.b" id="6" d="Vos ennemis n'osent plus sortir de chez eux;&#13;&#10;            votre alignement domine." e="70" n="Domination" s="60" />
<entree table="A.b" id="7" d="La puissance de votre alignement est telle que vous doutez de l'existence de vos ennemis." e="80" n="Tyrannie" s="70" />
<entree table="A.b" id="8" d="Votre alignement n'a plus de prédateur et la guerre est presque gagnée." e="90" n="Conquérant" s="80" />
<entree table="A.b" id="9" d="Votre alignement est au sommet et vos ennemis n'existent (probablement) plus." e="100" n="Apogée" s="90" />
